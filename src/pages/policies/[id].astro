---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
    const policies = await getCollection('policies');
    return policies.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = entry.body?.match(/^#\s+(.+)$/m)?.[1] ?? 'Policy';
---

<Base title={title}>
    <article class="prose">
        <Content />
    </article>
    <p class="small muted">
        Policies are governed in
        <a href="https://github.com/Arrow-air/arrow-catalog">arrow-catalog</a>.
    </p>
</Base>
