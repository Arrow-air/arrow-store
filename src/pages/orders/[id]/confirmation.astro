---
import { findOfferById, getCheckoutGroup, getManufacturer, loadCatalog } from '../../../catalog/load';
import Base from '../../../layouts/Base.astro';
import { buildCheckoutHandoffUrl } from '../../../lib/handoff';
import { countryName } from '../../../lib/regions';
import { getOrderForConfirmation } from '../../../server/orders';
import { getDb } from '../../../server/db';

export const prerender = false;

const { id } = Astro.params;
const token = Astro.url.searchParams.get('token');
const view = id && token ? getOrderForConfirmation(id, token) : null;

if (!view) {
    return new Response('Not found', { status: 404 });
}

const { order, items, contact } = view;
const catalog = loadCatalog();
const manufacturer = getManufacturer(order.manufacturer_id, catalog);
const manufacturerName = manufacturer?.displayName ?? order.manufacturer_id;

// Payment handoff, in order of preference: the manufacturer's checkout
// endpoint (handoff convention — one payment for the whole order), a
// per-offer checkout link, otherwise invoice instructions.
const checkoutGroup = getCheckoutGroup(order.checkout_group_id, catalog);
const handoffItems = items.map((item) => ({ offerId: item.offer_id, quantity: item.quantity }));
// Return URLs derive from the request origin, so localhost dev and production
// both send customers back to the right place (origin-allowlisted endpoint-side).
const returnUrls = {
    returnUrl: new URL('/orders/payment-complete', Astro.url.origin).toString(),
    cancelUrl: new URL('/', Astro.url.origin).toString(),
};
const handoffUrl =
    checkoutGroup?.mode === 'external-cart' && checkoutGroup.baseUrl
        ? buildCheckoutHandoffUrl(checkoutGroup.baseUrl, handoffItems, order.id, returnUrls)
        : undefined;
const payUrl =
    handoffUrl ??
    items
        .map((item) => findOfferById(item.offer_id, catalog)?.offer.checkout.url)
        .find((url) => url !== undefined);

const totalFormat =
    order.currency && new Intl.NumberFormat('en-US', { style: 'currency', currency: order.currency });
const total =
    order.subtotal_minor !== null && totalFormat
        ? totalFormat.format(order.subtotal_minor / 100)
        : undefined;

const placedAt = new Date(order.created_at).toUTCString();

// Determine payment method from order events
const events = db
    .prepare("SELECT data_json FROM order_events WHERE order_id = ? ORDER BY created_at DESC LIMIT 1")
    .all(id) as unknown as Array<{ data_json: string }>;
const eventData = events.length > 0 ? JSON.parse(events[0]!.data_json) : {};
const paymentMethod = eventData.paymentMethod ?? 'card';
const paymentMethodLabel = paymentMethod === 'usdc' ? 'USDC (on-chain)' : 'Card';
---

<Base title="Order received">
    <h1>Thanks — your order is in</h1>
    <p class="banner">
        Order reference <strong>{order.id}</strong>, placed {placedAt}.
    </p>

    <h2>Items</h2>
    <table class="cart-table">
        <thead>
            <tr>
                <th>Item</th>
                <th>Price</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            {
                items.map((item) => (
                    <tr>
                        <td>{item.name_snapshot}</td>
                        <td>{item.price_display === 'TBD' ? 'To be confirmed' : item.price_display}</td>
                        <td>{item.quantity}</td>
                    </tr>
                ))
            }
        </tbody>
    </table>

    <h2>Payment</h2>
    <div class="payment-info">
        <p class="payment-method-badge">
            Payment method: <strong>{paymentMethodLabel}</strong>
        </p>
        {total && (
            <p>
                Order total: <strong>{total}</strong>
            </p>
        )}
        {order.dao_fee_minor !== null && order.dao_fee_minor > 0 && (
            <p class="meta small">
                Includes DAO governance fee: {totalFormat ? totalFormat.format(order.dao_fee_minor / 100) : `${order.dao_fee_minor} minor units`}
            </p>
        )}
        {
            order.payment_mode === 'manufacturer-site' && payUrl ? (
                <p>
                    One payment covers your whole order, charged by {manufacturerName}:
                    <a class="btn" href={payUrl} style="margin-top: 0.5rem;">
                        Pay now{total ? ` — ${total}` : ''}
                    </a>
                </p>
            ) : (
                <p>
                    <strong>{manufacturerName}</strong> will contact you at{' '}
                    <strong>{contact.email}</strong> with payment instructions and to confirm
                    pricing and lead time.
                </p>
            )
        }
    </div>
    <p class="muted small">
        Your payment goes directly to {manufacturerName} as merchant of record — the Arrow
        store does not process payments.
    </p>

    <h2>Shipping to</h2>
    <p>
        {contact.full_name}<br />
        {contact.address_line1}<br />
        {contact.address_line2 && (
            <>
                {contact.address_line2}
                <br />
            </>
        )}
        {contact.city}{contact.region ? `, ${contact.region}` : ''} {contact.postal_code}<br />
        {countryName(contact.country)}
    </p>

    <p class="muted small">
        Keep this page's link to revisit your confirmation. Questions? Reply to the
        manufacturer's follow-up email{
            manufacturer?.supportEmail ? ` or contact ${manufacturer.supportEmail}` : ''
        }.
    </p>
</Base>

<style>
    .payment-info {
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .payment-method-badge {
        margin: 0 0 0.5rem;
        font-size: 0.9rem;
    }
</style>