---
import Base from '../layouts/Base.astro';
---

<Base title="Checkout">
    <h1>Checkout</h1>

    <section data-checkout-empty hidden>
        <p class="muted">Your cart is empty — there is nothing to check out yet.</p>
        <a class="btn secondary" href="/">Browse products</a>
    </section>

    <section data-checkout-form-section hidden>
        <p class="banner" data-checkout-banner></p>

        <h2>Order summary</h2>
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Price</th>
                    <th>Quantity</th>
                </tr>
            </thead>
            <tbody data-checkout-items></tbody>
        </table>

        <h2>Payment method</h2>
        <div class="payment-methods" data-payment-methods>
            <label class="payment-option card selected" data-payment-option="card">
                <input type="radio" name="paymentMethod" value="card" checked />
                <div class="payment-option-content">
                    <strong>Card</strong>
                    <span class="meta">Pay with credit or debit card. The manufacturer charges
                    your card directly upon order confirmation.</span>
                </div>
            </label>
            <label class="payment-option usdc" data-payment-option="usdc">
                <input type="radio" name="paymentMethod" value="usdc" />
                <div class="payment-option-content">
                    <strong>USDC (on-chain)</strong>
                    <span class="meta">Pay with USDC from a wallet. On-chain settlement via
                    smart contract — the manufacturer sends a payment link after placing
                    the order.</span>
                </div>
            </label>
        </div>

        <h2>DAO fee</h2>
        <div class="dao-fee-info">
            <p class="meta">
                A small DAO governance fee is included in the price. This fee supports
                Arrow's open development, community governance, and protocol improvements.
                The exact amount is confirmed by the manufacturer before payment.
            </p>
            <p class="meta small" data-dao-fee-status></p>
        </div>

        <h2>Contact &amp; shipping</h2>
        <form class="checkout-form" data-checkout-form novalidate>
            <label>
                Full name
                <input name="fullName" required maxlength="200" autocomplete="name" />
            </label>
            <label>
                Email
                <input name="email" type="email" required maxlength="320" autocomplete="email" />
            </label>
            <label>
                Phone (optional)
                <input name="phone" type="tel" maxlength="50" autocomplete="tel" />
            </label>
            <label>
                Address line 1
                <input name="addressLine1" required maxlength="200" autocomplete="address-line1" />
            </label>
            <label>
                Address line 2 (optional)
                <input name="addressLine2" maxlength="200" autocomplete="address-line2" />
            </label>
            <div class="field-row">
                <label>
                    City
                    <input name="city" required maxlength="100" autocomplete="address-level2" />
                </label>
                <label>
                    State / region (optional)
                    <input name="region" maxlength="100" autocomplete="address-level1" />
                </label>
            </div>
            <div class="field-row">
                <label>
                    Postal code
                    <input name="postalCode" required maxlength="20" autocomplete="postal-code" />
                </label>
                <label>
                    Country
                    <select name="country" required data-country-select></select>
                </label>
            </div>
            <label>
                Order notes (optional)
                <textarea name="customerNotes" rows="3" maxlength="2000"></textarea>
            </label>
            <p class="error-text" data-checkout-error hidden></p>
            <button class="btn" type="submit">Place order</button>
            <p class="muted small">
                Placing an order sends your details to the manufacturer so they can arrange
                payment and shipping. The store does not process payments — your card or
                wallet is charged directly by the manufacturer.
            </p>
        </form>
    </section>
</Base>

<script>
    import { clearCart, getCart } from '../lib/cart';
    import { countryName, shippableCountries } from '../lib/regions';

    const emptySection = document.querySelector<HTMLElement>('[data-checkout-empty]')!;
    const formSection = document.querySelector<HTMLElement>('[data-checkout-form-section]')!;
    const banner = document.querySelector<HTMLElement>('[data-checkout-banner]')!;
    const tbody = document.querySelector<HTMLElement>('[data-checkout-items]')!;
    const form = document.querySelector<HTMLFormElement>('[data-checkout-form]')!;
    const countrySelect = document.querySelector<HTMLSelectElement>('[data-country-select]')!;
    const errorText = document.querySelector<HTMLElement>('[data-checkout-error]')!;
    const paymentOptions = document.querySelectorAll<HTMLElement>('[data-payment-option]');
    const daoFeeStatus = document.querySelector<HTMLElement>('[data-dao-fee-status]');

    const cart = getCart();
    if (cart.items.length === 0) {
        emptySection.hidden = false;
    } else {
        formSection.hidden = false;
        banner.textContent =
            `This order is fulfilled and charged by ${cart.manufacturerName} as merchant of ` +
            'record. You will receive payment instructions after placing the order.';

        for (const item of cart.items) {
            const row = document.createElement('tr');
            for (const value of [item.name, item.priceDisplay, String(item.quantity)]) {
                const cell = document.createElement('td');
                cell.textContent = value;
                row.appendChild(cell);
            }
            tbody.appendChild(row);
        }

        const countries = shippableCountries(cart.items.map((item) => item.shipsTo));
        for (const code of countries) {
            const option = document.createElement('option');
            option.value = code;
            option.textContent = countryName(code);
            countrySelect.appendChild(option);
        }

        // DAO fee info
        if (daoFeeStatus) {
            daoFeeStatus.textContent =
                `Manufacturer: ${cart.manufacturerName}. ` +
                'The DAO fee is included in the manufacturer\'s price and is remitted on-chain.';
        }
    }

    // Payment method selection UX
    for (const option of paymentOptions) {
        option.addEventListener('click', () => {
            for (const opt of paymentOptions) opt.classList.remove('selected');
            option.classList.add('selected');
            const radio = option.querySelector<HTMLInputElement>('input[type="radio"]');
            if (radio) radio.checked = true;
        });
    }

    function showError(message: string): void {
        errorText.textContent = message;
        errorText.hidden = false;
    }

    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorText.hidden = true;

        if (!form.reportValidity()) return;

        const data = new FormData(form);
        const optional = (name: string): string | undefined => {
            const value = String(data.get(name) ?? '').trim();
            return value === '' ? undefined : value;
        };

        const paymentMethod = form.querySelector<HTMLInputElement>(
            'input[name="paymentMethod"]:checked',
        )?.value ?? 'card';

        const payload = {
            items: getCart().items.map((item) => ({
                offerId: item.offerId,
                quantity: item.quantity,
            })),
            customer: {
                fullName: String(data.get('fullName')).trim(),
                email: String(data.get('email')).trim(),
                phone: optional('phone'),
                addressLine1: String(data.get('addressLine1')).trim(),
                addressLine2: optional('addressLine2'),
                city: String(data.get('city')).trim(),
                region: optional('region'),
                postalCode: String(data.get('postalCode')).trim(),
                country: String(data.get('country')),
            },
            customerNotes: optional('customerNotes'),
            paymentMethod,
        };

        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        submit.disabled = true;
        try {
            const response = await fetch('/api/orders', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const result = (await response.json()) as {
                confirmationUrl?: string;
                error?: string;
                issues?: string[];
            };
            if (response.ok && result.confirmationUrl) {
                clearCart();
                window.location.assign(result.confirmationUrl);
                return;
            }
            showError(result.issues?.join('; ') ?? result.error ?? 'Order could not be placed.');
        } catch {
            showError('Network error — your order was not placed. Please try again.');
        } finally {
            submit.disabled = false;
        }
    });
</script>

<style>
    .payment-methods {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .payment-option {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 1rem;
        border: 1px solid var(--border);
        cursor: pointer;
        transition: border-color 0.2s, background-color 0.2s;
    }

    .payment-option:hover {
        border-color: var(--card-border);
        background: var(--card-hover);
    }

    .payment-option.selected {
        border-color: var(--primary);
        background: var(--primary-light);
    }

    .payment-option input[type="radio"] {
        margin-top: 0.2rem;
    }

    .payment-option-content {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .payment-option-content .meta {
        font-size: 0.85rem;
        color: var(--text-secondary);
        line-height: 1.4;
    }

    .dao-fee-info {
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .dao-fee-info .meta {
        margin: 0;
        color: var(--text-secondary);
    }

    .dao-fee-info .meta.small {
        font-size: 0.8rem;
        margin-top: 0.5rem;
        color: var(--text-muted);
    }
</style>