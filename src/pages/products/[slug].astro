---
import {
    getAddOnProducts,
    getManufacturer,
    getProductBySlug,
    getVisibleOffers,
    loadCatalog,
} from '../../catalog/load';
import OfferCard from '../../components/OfferCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Modal from '../../components/Modal.astro';
import Base from '../../layouts/Base.astro';
import { LIFECYCLE_STAGE_LABELS } from '../../lib/display';

export function getStaticPaths() {
    return loadCatalog().products.map((product) => ({ params: { slug: product.slug } }));
}

const { slug } = Astro.params;
const catalog = loadCatalog();
const product = getProductBySlug(slug, catalog)!;
const offers = getVisibleOffers(product);
const addOns = getAddOnProducts(product, catalog);

const lineItemSections = [
    { title: "What's included", items: product.included ?? [] },
    { title: 'Not included', items: product.notIncluded ?? [] },
    { title: 'Required separately', items: product.requiredSeparately ?? [] },
].filter((section) => section.items.length > 0);
---

<Base title={product.name} description={product.shortDescription}>
    <section class="hero">
        <div>
            <StatusBadge status={product.status} />
            {
                product.lifecycleStage && (
                    <span class="chip">
                        {LIFECYCLE_STAGE_LABELS[product.lifecycleStage] ?? product.lifecycleStage}
                    </span>
                )
            }
        </div>
        <h1>{product.name}</h1>
        <p>{product.shortDescription}</p>
    </section>

    <section class="routing-info">
        <h2>Choose your manufacturer</h2>
        <p class="muted">
            Your order is fulfilled and charged by the manufacturer you choose. The store
            routes you to the nearest manufacturer by default — you can change it below.
        </p>
        <div class="grid">
            {
                offers.map((offer, index) => {
                    const manufacturer = getManufacturer(offer.manufacturerId, catalog)!;
                    const isNearest = index === 0;
                    return (
                        <div class="offer-wrapper">
                            {isNearest && <span class="badge neutral">Nearest manufacturer</span>}
                            <OfferCard
                                product={product}
                                offer={offer}
                                manufacturer={manufacturer}
                                catalogRef={catalog.manifest.resolvedSha}
                            />
                        </div>
                    );
                })
            }
        </div>
    </section>

    {
        lineItemSections.map((section) => (
            <section>
                <h2>{section.title}</h2>
                <ul class="plain">
                    {section.items.map((item) => (
                        <li>
                            {item.label}
                            {item.quantity !== undefined && ` × ${item.quantity}`}
                            {item.notes && <span class="note">{item.notes}</span>}
                        </li>
                    ))}
                </ul>
            </section>
        ))
    }

    {
        product.standards.length > 0 && (
            <section>
                <h2>Build standards</h2>
                <ul class="plain">
                    {product.standards.map((standard) => (
                        <li>
                            <a href={standard.url}>{standard.label}</a>
                            {standard.required && <span class="chip">Required</span>}
                            {standard.description && (
                                <span class="note">{standard.description}</span>
                            )}
                        </li>
                    ))}
                </ul>
            </section>
        )
    }

    <section class="manufacturer-section">
        <h2>Who builds it</h2>
        <p class="muted">
            Each manufacturer builds and ships the product directly. The store connects you
            with the one that serves your region.
        </p>
        <div class="grid">
            {
                offers.map((offer) => {
                    const manufacturer = getManufacturer(offer.manufacturerId, catalog)!;
                    return (
                        <article class="card manufacturer-card">
                            <h3>{manufacturer.displayName}</h3>
                            {manufacturer.description && <p class="meta">{manufacturer.description}</p>}
                            {manufacturer.supportEmail && (
                                <p class="meta small">
                                    Contact: <a href={`mailto:${manufacturer.supportEmail}`}>{manufacturer.supportEmail}</a>
                                </p>
                            )}
                            {offer.regionLabel && <span class="chip">{offer.regionLabel}</span>}
                        </article>
                    );
                })
            }
        </div>
    </section>

    {
        addOns.length > 0 && (
            <section>
                <h2>Add-ons from the same manufacturers</h2>
                <p class="muted">
                    These can ship in the same order because they share a manufacturer checkout
                    group.
                </p>
                <div class="grid">
                    {addOns.map((addOn) => (
                        <ProductCard product={addOn} />
                    ))}
                </div>
            </section>
        )
    }

    <section>
        <h2>Support & warranty</h2>
        <ul class="plain">
            <li><a href={`/policies/${product.supportPolicyId}`}>Support policy</a></li>
            <li><a href={`/policies/${product.warrantyPolicyId}`}>Warranty policy</a></li>
        </ul>
    </section>

    <Modal id="group-conflict-modal" title="Different manufacturer">
        <p></p>
        <div class="modal-actions" style="display: flex; gap: 0.5rem; margin-top: 1rem;"></div>
    </Modal>
</Base>

<script>
    import { addItem, startNewCartWith, type OfferSnapshot } from '../../lib/cart';

    for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-offer]')) {
        button.addEventListener('click', () => {
            const snapshot = JSON.parse(button.dataset.offer!) as OfferSnapshot;
            const result = addItem(snapshot);
            if (!result.ok) {
                // Show the group-conflict modal instead of window.confirm
                const modalOverlay = document.getElementById('group-conflict-modal');
                const modalBody = modalOverlay?.querySelector('.modal-body');
                if (modalOverlay && modalBody) {
                    modalBody.textContent = `Your cart contains items from ${
                        result.currentManufacturerName
                    }. Each order is fulfilled and charged by a single manufacturer, so this item needs a separate order.`;
                    modalOverlay.hidden = false;

                    const confirmBtn = document.createElement('button');
                    confirmBtn.className = 'btn';
                    confirmBtn.textContent = 'Empty cart and start new order';
                    confirmBtn.addEventListener('click', () => {
                        startNewCartWith(snapshot);
                        modalOverlay.hidden = true;
                        const original = button.textContent;
                        button.textContent = 'Added to cart ✓';
                        button.disabled = true;
                        window.setTimeout(() => {
                            button.textContent = original;
                            button.disabled = false;
                        }, 1200);
                    });

                    const cancelBtn = document.createElement('button');
                    cancelBtn.className = 'btn secondary';
                    cancelBtn.textContent = 'Keep current cart';
                    cancelBtn.addEventListener('click', () => {
                        modalOverlay.hidden = true;
                    });

                    // Clear previous buttons and append
                    const actions = modalBody.querySelector('.modal-actions');
                    if (actions) {
                        actions.replaceChildren(confirmBtn, cancelBtn);
                    } else {
                        const actionsDiv = document.createElement('div');
                        actionsDiv.className = 'modal-actions';
                        actionsDiv.style.cssText = 'display: flex; gap: 0.5rem; margin-top: 1rem;';
                        actionsDiv.appendChild(cancelBtn);
                        actionsDiv.appendChild(confirmBtn);
                        modalBody.appendChild(actionsDiv);
                    }
                    return;
                }
            }
            const original = button.textContent;
            button.textContent = 'Added to cart ✓';
            button.disabled = true;
            window.setTimeout(() => {
                button.textContent = original;
                button.disabled = false;
            }, 1200);
        });
    }

    // Close modal on overlay click
    document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.classList.contains('modal-overlay') || target.closest('[data-modal-close]')) {
            const modal = target.closest('[data-modal]') as HTMLElement;
            if (modal) modal.hidden = true;
        }
    });
</script>
