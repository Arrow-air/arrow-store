# All variables are optional. Never commit a real .env file.

# Use a local checkout of arrow-catalog instead of fetching from GitHub:
# ARROW_CATALOG_LOCAL_PATH=../arrow-catalog

# Override the catalog repository (defaults to the value in catalog.lock.json):
# ARROW_CATALOG_REPO=Arrow-air/arrow-catalog

# Override the pinned ref from catalog.lock.json:
# ARROW_CATALOG_REF=main

# GitHub token to raise API rate limits (set automatically in CI):
# GITHUB_TOKEN=

# SQLite database location (defaults to data/store.db):
# DB_PATH=data/store.db
